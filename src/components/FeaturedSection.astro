---
export interface FeaturedItem {
  title: string;
  subtitle: string;
  type?: string;
  date?: string;
  url: string;
  coverImage: string;
}

interface Props {
  sectionTitle?: string;
  sectionSubtitle?: string;
  items: FeaturedItem[];
}

const { sectionTitle, sectionSubtitle, items } = Astro.props;
---

<section class="featured-section">
  {
    sectionTitle && (
      <div class="featured-header">
        <h2 class="featured-title">{sectionTitle}</h2>
        {sectionSubtitle && <p class="featured-subtitle">{sectionSubtitle}</p>}
      </div>
    )
  }

  <div class="featured-grid">
    {
      items.map((item) => (
        <a
          href={item.url}
          class="featured-item"
          target={item.url.startsWith("http") ? "_blank" : "_self"}
          rel={item.url.startsWith("http") ? "noopener noreferrer" : ""}
        >
          <div class="featured-image-wrapper">
            <img
              src={item.coverImage}
              alt={item.title}
              class="featured-image"
              loading="lazy"
            />
          </div>
          <h3 class="featured-item-title">{item.title}</h3>
        </a>
      ))
    }
  </div>
</section>

<style>
  .featured-section {
    margin: 0;
  }

  .featured-header {
    margin-bottom: 1.25rem;
  }

  .featured-title {
    font-family: var(--font-family-serif);
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0 0 0.25rem;
    color: var(--text-primary);
  }

  .featured-subtitle {
    font-family: var(--font-family-sans);
    font-weight: 400;
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem 1.25rem;
  }

  .featured-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .featured-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--background-elevated, rgba(0, 0, 0, 0.05));
    overflow: hidden;
  }

  .featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .featured-item:hover .featured-image,
  .featured-item:focus-visible .featured-image {
    transform: scale(1.03);
  }

  .featured-item-title {
    font-family: var(--font-family-sans);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0.5rem 0 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .featured-item:hover .featured-item-title,
  .featured-item:focus-visible .featured-item-title {
    color: var(--text-primary);
  }

  @media screen and (max-width: 520px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 0.75rem;
    }

    .featured-item-title {
      font-size: 0.8rem;
    }
  }
</style>
